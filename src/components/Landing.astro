import { tinaField } from '@tinacms/astro/tina-field';
const { d = {} } = Astro.props as any;
const f:any = d;
const t = (k:string, fallback:string)=> (f && f[k] != null && f[k] !== '') ? f[k] : fallback;
const pick = (obj:any, key:string, fallback:string)=> (obj && obj[key] != null && obj[key] !== '') ? obj[key] : fallback;
// preserve figma exact strings
const seoTitle = t('seo_title','Hearth & Honey — Your neighborhood spot for coffee and good company');
const heroBg = f?.hero_background || 'https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1920&q=80';
const heroHeading = t('hero_heading','Your neighborhood spot for coffee and good company');
const heroText = t('hero_text','We serve specialty coffee, fresh pastries, and all-day breakfast in a warm, modern space. Come in, sit down, and stay awhile.');
const heroBtns = f?.hero_buttons || [{label:'Explore Menu',href:'#menu'},{label:'Book a Table',href:'#book'}];
const navLinks = f?.navbar_links || [{label:'Our story',href:'#story'},{label:'Menu',href:'#menu'},{label:'Visit',href:'#visit',dropdown:['Hours','Location','Contact']}];
// Banner (full content left)
const banner = f?.banner || {};
const bannerEnabled = banner.enabled !== false;
const bannerHeading = pick(banner,'heading','Fresh pastries are half off after 3 pm');
const bannerText = pick(banner,'text','Join the list for the daily special');
const bannerPlaceholder = pick(banner,'placeholder','Enter your email');
const bannerButton = pick(banner,'button','Sign up');
// Navbar
const navbarObj = f?.navbar || {};
const navLogo = pick(navbarObj,'logo','Hearth & Honey');
const navCtaLabel = pick(navbarObj,'cta_label','Book a Table');
const navCtaHref = pick(navbarObj,'cta_href','#book');
// About (supports both flat about_heading/about_text and nested about object for full left)
const aboutObj = f?.about || {};
const aboutTagline = pick(aboutObj,'tagline','About');
const aboutHeading = pick(aboutObj,'heading', t('about_heading','A good café is a clean, well-lighted place'));
const aboutText = pick(aboutObj,'text', t('about_text','We built Hearth & Honey to be simple and true. Good coffee, honest food, and a room that feels right.'));
const aboutImage = pick(aboutObj,'image','/shots/figma-1.png');
// Menu
const menuObj = f?.menu || {};
const menuTag = pick(menuObj,'tag','Menu');
const menuHeading = pick(menuObj,'heading','What we do well');
const menuText = pick(menuObj,'text','A few things we make every day. They are simple and they are good.');
const menuTabs = (menuObj?.tabs && menuObj.tabs.length ? menuObj.tabs : [
  {id:'coffee',label:'Coffee',tag:'Coffee',heading:'The flat white is true and strong',text:'We pull shots from beans roasted two miles away. The milk is steamed clean, no tricks.',image:'/shots/figma-2.png'},
  {id:'breakfast',label:'Breakfast',tag:'Breakfast',heading:'Morning plates done right',text:'Eggs, sourdough, and seasonal sides — simple and satisfying.',image:'https://images.unsplash.com/photo-1490818387583-1baba5e638af?auto=format&fit=crop&w=800&q=80'},
  {id:'brunch',label:'Brunch',tag:'Brunch',heading:'Long table, good coffee',text:'Bring friends. We keep the kitchen open till three.',image:'https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&w=800&q=80'},
  {id:'pastries',label:'Pastries',tag:'Pastries',heading:'Baked every morning',text:'Croissants, buns, and half-price after 3 pm.',image:'https://images.unsplash.com/photo-1555507036-ab1f4038808a?auto=format&fit=crop&w=800&q=80'},
  {id:'light',label:'Light meals',tag:'Light meals',heading:'Soups and salads',text:'Fresh, honest, and quick.',image:'https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=800&q=80'},
  {id:'drinks',label:'Drinks',tag:'Drinks',heading:'More than coffee',text:'Tea, juice, and cold brew on tap.',image:'https://images.unsplash.com/photo-1551024506-0bccd828d307?auto=format&fit=crop&w=800&q=80'},
]);
// Testimonials
const testiObj = f?.testimonials || {};
const testiHeading = pick(testiObj,'heading','Customer testimonials');
const testiText = pick(testiObj,'text','Come for the coffee. Stay for the moment.');
const testiItems = (testiObj?.items && testiObj.items.length ? testiObj.items : [
  {quote:'The espresso is the best in the neighborhood. No argument.',stars:5,avatar:'/shots/avatar-0.jpg',name:'Maya Chen',role:'Regular'},
  {quote:'A clean, bright room where a man can sit alone with a paper and not be bothered.',stars:5,avatar:'/shots/avatar-1.jpg',name:'Daniel Brooks',role:'Local writer'},
  {quote:'The sourdough toast with eggs is honest food. It does not pretend.',stars:5,avatar:'/shots/avatar-2.jpg',name:'Sarah Kim',role:'Brunch regular'},
]);
// FAQ
const faqObj = f?.faq || {};
const faqHeading = pick(faqObj,'heading','FAQs');
const faqText = pick(faqObj,'text','Find quick answers about your visit to Hearth & Honey');
const faqItems = (faqObj?.items && faqObj.items.length ? faqObj.items : [
  {q:'What are your hours?',a:'We are open Monday through Friday from 7 am to 4 pm. Weekends we open at 8 am and close at 3 pm.'},
  {q:'Do you have Wi-Fi?',a:'Yes, the Wi-Fi is free and fast. Bring your laptop and settle in.'},
  {q:'Do you offer vegan options?',a:'We always have oat and almond milk for coffee. The kitchen keeps a few vegan dishes on the menu each day.'},
  {q:'Do I need a reservation?',a:'Walk-ins are always welcome. For groups of six or more, a quick call ahead helps us save you a table.'},
  {q:'Is there gluten-free food?',a:'We bake a gluten-free banana bread most mornings. Ask at the counter for what is available that day.'},
]);
const faqStillHeading = pick(faqObj,'still_heading','Still have questions?');
const faqStillText = pick(faqObj,'still_text',"Haven't found what you're looking for? Our team is happy to help — ask us anything.");
const faqStillButton = pick(faqObj,'still_button','Get in Touch');
// Contact
const contactObj = f?.contact || {};
const contactTagline = pick(contactObj,'tagline','Visit Us');
const contactHeading = pick(contactObj,'heading','Contact us');
const contactText = pick(contactObj,'text','Find us on Hearth Lane — open daily from 7am. Drop in, call ahead, or send a note.');
const contactItems = (contactObj?.items && contactObj.items.length ? contactObj.items : [
  {heading:'Email',text:'For general enquiries and catering',link:'hello@hearthandhoney.example',link_text:'hello@hearthandhoney.example'},
  {heading:'Phone',text:'For reservations and takeaway orders',link:'tel:+61290001234',link_text:'+61 2 9000 1234'},
  {heading:'Visit',text:'12 Hearth Lane, Surry Hills NSW 2010 AU',link:'#',link_text:'Get Directions'},
]);
const contactImage = pick(contactObj,'image','/shots/figma-3.png');
// CTA
const ctaObj = f?.cta || {};
const ctaHeading = pick(ctaObj,'heading','See you at the counter');
const ctaText = pick(ctaObj,'text','Stop by for a coffee or stay for brunch. The kettle is on and the door is open.');
// Footer
const footerObj = f?.footer || {};
const footerNewsletterHeading = pick(footerObj,'newsletter_heading','Get in touch');
const footerNewsletterText = pick(footerObj,'newsletter_text','Get the word on new roasts and weekend specials. No noise, just news.');
const footerPlaceholder = pick(footerObj,'placeholder','Enter your email');
const footerButton = pick(footerObj,'button','Subscribe');
const footerFineprint = pick(footerObj,'fineprint','By subscribing you agree to our Privacy Policy');
---
<style>
:root{--green:#1A472C;--peach:#FFECCC;--mustard:#D99E4F;--yellow:#FEC135;--ever:#005B4A;--brown:#916F44;--black:#0A1C11;--cream:#FAF3E3;--white:#fff;}
.reveal{will-change:transform,opacity}
*{box-sizing:border-box}
html,body{margin:0;padding:0;background:var(--peach);color:#000;font-family:'DM Sans',system-ui,sans-serif;overflow-x:hidden}
a{color:inherit;text-decoration:none}
img{display:block;max-width:100%}
/* container */
.wrap{max-width:1440px;margin:0 auto}
.inner{max-width:1280px;margin:0 auto;width:100%}
/* Banner */
.banner{background:var(--peach);padding:6px 64px 0}
.banner-card{background:var(--green);color:#fff;border-radius:32px;outline:2px solid #fff;outline-offset:-2px;display:flex;align-items:center;justify-content:space-between;gap:32px;padding:12px 16px;flex-wrap:wrap}
.banner-left{display:flex;align-items:center;gap:16px;flex:1;min-width:280px}
.banner-left h2{font-size:16px;font-weight:600;line-height:24px;margin:0}
.banner-left p{font-size:14px;line-height:21px;margin:0;opacity:.95}
.banner-form{display:flex;align-items:center;gap:16px;flex-shrink:0}
.banner-form .field{flex:1;min-width:180px;border-bottom:2px solid #fff;display:flex;align-items:center;padding:8px 0;gap:8px}
.banner-form .field input::placeholder{color:rgba(255,255,255,.6)}
.banner-form .field input:focus{outline:none}
.banner-form .field span{color:rgba(255,255,255,.6);font-size:16px}
.btn-yellow{background:var(--yellow);color:#000;border-radius:6px;outline:1px solid var(--yellow);padding:4px 10px;font-weight:500;font-size:16px;line-height:24px;white-space:nowrap;border:none;cursor:pointer}
.banner-x{width:32px;height:32px;display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0}
/* Navbar */
.navbar{background:var(--peach);padding:10px 64px 12px;border-bottom:1px solid transparent}
.nav-inner{display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap}
.nav-logo{width:auto;height:36px;flex-shrink:0;display:flex;align-items:center;white-space:nowrap}
.nav-mid{flex:1;display:flex;justify-content:flex-end}
.nav-right{display:flex;align-items:center;gap:32px}
.nav-link{font-size:16px;color:var(--ever);line-height:24px;display:flex;align-items:center;gap:4px;cursor:pointer;position:relative;white-space:nowrap}
.nav-btn{background:var(--mustard);color:#fff;border-radius:6px;outline:1px solid #000;padding:4px 10px;font-weight:500;font-size:16px;border:none;cursor:pointer;white-space:nowrap}
.dropdown{position:relative}
.dropdown-menu{position:absolute;left:50%;top:calc(100% + 8px);transform:translateX(-50%);background:var(--mustard);border-radius:24px;outline:2px solid #000;outline-offset:-2px;padding:24px;display:flex;flex-direction:column;gap:16px;min-width:180px;max-width:calc(100vw - 32px);max-height:calc(100vh - 100px);overflow-y:auto;z-index:50;display:none;box-shadow:0 12px 32px rgba(0,0,0,.18)}
.dropdown.open .dropdown-menu,.dropdown:hover .dropdown-menu{display:flex}
@media(max-width:1024px){.dropdown-menu{position:fixed;left:16px;right:16px;top:auto;transform:none;min-width:0;max-width:none;width:auto;margin-top:8px;max-height:60vh}.dropdown:hover .dropdown-menu{display:none}.dropdown.open .dropdown-menu{display:flex}}
@media(max-width:640px){.dropdown-menu{left:12px;right:12px;padding:20px}}
.dropdown-menu a{font-size:16px;color:#000;padding:8px 12px;border-radius:8px;transition:background .18s ease,transform .18s ease;display:block}
.dropdown-menu a:hover{background:var(--yellow);transform:translateX(2px)}
.dropdown:hover .nav-link{color:var(--mustard)}
/* Hero */
.hero{position:relative;min-height:900px;background:linear-gradient(0deg,rgba(0,0,0,.40),rgba(0,0,0,.40)),url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1920&q=80') center/cover no-repeat;display:flex;align-items:stretch;padding:0 64px;overflow:hidden}
.hero-grid{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:stretch;width:100%;padding:112px 0;max-width:1280px;margin:0 auto}
.hero-grid > div:first-child{align-self:start}
.hero-right{display:flex;flex-direction:column;gap:24px;justify-content:flex-end;align-self:end;text-align:left}
.hero h1{font-family:'Fraunces',serif;font-weight:600;font-size:72px;line-height:86.4px;color:#fff;margin:0;text-wrap:balance}
.hero .sub{color:#fff;font-size:18px;line-height:27px;margin:0}
.hero-actions{display:flex;gap:16px;flex-wrap:wrap;align-items:center;margin-top:8px}
.hero-actions a{width:fit-content}
.btn-mustard{background:var(--mustard);color:#000;border-radius:6px;outline:1px solid var(--yellow);padding:6px 12px;font-weight:500;font-size:16px;display:inline-flex;align-items:center;justify-content:center;gap:8px;border:none;cursor:pointer;transition:transform .2s ease, background .2s ease, box-shadow .2s ease}
.btn-mustard:hover{transform:translateY(-2px);box-shadow:0 4px 12px rgba(0,0,0,.15)}
.btn-mustard:active{transform:translateY(0) scale(.98)}
.btn-outline-dark{padding:6px 12px;border-radius:6px;outline:2px solid #000;font-weight:500;font-size:16px;display:inline-flex;align-items:center;gap:8px;cursor:pointer;background:transparent;color:#000;transition:transform .2s ease, background .2s ease, color .2s ease}
.btn-outline-dark:hover{transform:translateY(-2px);background:rgba(0,0,0,.06)}
.btn-outline-dark:active{transform:translateY(0) scale(.98)}
.hero .btn-outline-dark:hover{background:rgba(255,255,255,.12);color:#fff}
.hero .btn-outline-dark{color:#000;background:transparent;border:none;outline:2px solid #000}
/* Layout1 About */
.about{background:var(--peach);padding:80px 64px}
.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center}
.tagline{font-family:'Great Vibes', cursive;font-size:30px;line-height:30px;color:var(--ever);font-weight:600;letter-spacing:0.03em;margin:0;text-shadow:0 0 0.5px var(--ever)}
.about h2{font-family:'Fraunces',serif;font-weight:600;font-size:52px;line-height:62.4px;color:#000;margin:0}
.about p{font-size:18px;line-height:27px;color:#000;margin:0}
.about-img{height:640px;border-radius:32px;width:100%;object-fit:cover}
.about-actions{display:flex;gap:24px;align-items:center;margin-top:8px}
/* Menu 507 */
.menu-sec{background:var(--peach);padding:0 64px 64px}
.menu-card{background:var(--ever);border-radius:32px;padding:48px 0 0;display:flex;flex-direction:column;align-items:center;gap:40px;overflow:hidden}
.menu-head{max-width:768px;text-align:center;display:flex;flex-direction:column;gap:24px;padding:16px 24px 0;width:100%}
.menu-head .tag{color:var(--yellow);font-family:'Great Vibes', cursive;font-weight:600;font-size:38px;line-height:38px;letter-spacing:0.04em;text-shadow:0 0 0.5px var(--yellow)}
.menu-head h2{color:#fff;font-family:'Fraunces',serif;font-weight:600;font-size:52px;line-height:62.4px;margin:0}
.menu-head p{color:#fff;font-size:18px;line-height:27px;margin:0}
.tabs{width:100%;background:var(--yellow);overflow:hidden;border-radius:0 0 32px 32px;outline:2px solid #000;outline-offset:-2px;display:flex;flex-direction:column;margin:0;outline-top:none;border-top:none}
.tabs-menu{display:grid;grid-template-columns:repeat(6,1fr);border-bottom:2px solid var(--black);background:var(--yellow)}
@media(max-width:1024px){ .tabs-menu{grid-template-columns:repeat(3,1fr)} }
@media(max-width:640px){ .tabs-menu{grid-template-columns:repeat(2,1fr)} }
@media(max-width:480px){ .tabs-menu{grid-template-columns:1fr} }
.tab-btn{padding:24px 20px;text-align:center;font-family:'Fraunces',serif;font-weight:600;font-size:22px;line-height:30.8px;color:var(--ever);cursor:pointer;background:var(--cream);border:1px solid var(--black);border-right:2px solid var(--black);border-bottom:2px solid var(--black);margin:-1px 0 0 -1px;transition:background .18s ease}
.tab-btn:hover{background:#fff}
.tabs-menu .tab-btn:first-child{border-left:2px solid var(--black)}
.tab-btn:last-child{border-right:none}
.tab-btn.active{background:#fff}
.tab-pane{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;background:var(--brown);padding:48px;color:#fff;min-height:520px;position:relative;z-index:1}
.tab-pane h3{font-family:'Fraunces',serif;font-weight:600;font-size:44px;line-height:52.8px;margin:0}
.tab-pane p{font-size:16px;line-height:24px;margin:0}
.tab-pane .tag{font-size:16px;font-weight:600}
.tab-pane img{height:552px;border-radius:32px;width:100%;object-fit:cover}
/* Testimonials */
.testi{background:var(--peach);padding:80px 64px}
.testi-head{max-width:768px;margin:0 auto;text-align:center;display:flex;flex-direction:column;gap:24px}
.testi-head h2{font-family:'Fraunces',serif;font-weight:600;font-size:52px;line-height:62.4px;margin:0}
.testi-head p{font-family:'Cormorant Garamond', serif; font-style:italic; font-weight:500; font-size:23px;line-height:31px;margin:0; color:#333}
.testi-wrap{position:relative;margin-top:48px}
.testi-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:24px}
.testi-card{background:#fff;border-radius:32px;outline:2px solid #000;outline-offset:-2px;padding:32px;display:flex;flex-direction:column;gap:24px;min-height:260px}
.stars{display:flex;gap:4px;flex-wrap:wrap}
.stars .star-svg{transition:transform .18s ease, filter .18s ease; cursor:pointer}
.stars:hover .star-svg{opacity:.6}
.stars .star-svg:hover{transform:scale(1.25); opacity:1; filter:brightness(1.15)}
.stars .star-svg:hover ~ .star-svg{opacity:.35}
.quote{font-family:'Cormorant Garamond', serif; font-style:italic; font-weight:500; font-size:25px; line-height:33px; letter-spacing:0.01em}
.quote script{font-family:'Great Vibes', cursive}
.script-accent{font-family:'Great Vibes', cursive; font-size:32px; line-height:1; color:var(--mustard); font-weight:400}
.tagline-script{font-family:'Great Vibes', cursive; font-size:28px; line-height:32px; color:var(--ever); font-weight:400; letter-spacing:0.02em}
@media(max-width:768px){ .stars{gap:3px} .stars .star-svg{width:16px;height:15px} }
@media(max-width:480px){ .stars{gap:2px} .stars .star-svg{width:14px;height:13px} }
.avatar{display:flex;gap:16px;align-items:center}
.avatar img{width:48px;height:48px;border-radius:50%;object-fit:cover;flex-shrink:0}
@media(max-width:768px){ .avatar img{width:40px;height:40px} }
.avatar b{font-size:16px;font-weight:600;line-height:24px;display:block}
.avatar span{font-size:16px;line-height:24px}
.dots{display:none}
.slider-arrow{position:absolute;top:50%;transform:translateY(-50%);background:var(--mustard);border-radius:4px;outline:2px solid #000;outline-offset:-2px;padding:12px;cursor:pointer;display:flex}
.slider-arrow.left{left:-18px}
.slider-arrow.right{right:-18px}
/* FAQ */
.faq{background:var(--peach);padding:80px 64px}
.faq-head{max-width:768px;margin:0 auto;text-align:center;display:flex;flex-direction:column;gap:24px}
.faq-head h2{font-family:'Fraunces',serif;font-weight:600;font-size:52px;line-height:62.4px;margin:0}
.faq-head p{font-size:18px;line-height:27px;margin:0}
.accordion-list{max-width:768px;margin:48px auto 0;display:flex;flex-direction:column;gap:16px}
.accordion{background:#fff;border-radius:32px;outline:2px solid var(--black);outline-offset:-2px;overflow:hidden;cursor:pointer;transition:outline-color .18s ease}
.accordion.open{outline-color:var(--mustard);outline-width:2px}
.accordion:hover{outline-color:var(--black)}
.accordion-q{display:flex;align-items:center;justify-content:space-between;padding:20px 24px;gap:24px}
.accordion-q b{font-size:18px;font-weight:700;line-height:27px}
.accordion-a{padding:0 24px 24px;display:none}
.accordion.open .accordion-a{display:flex}
.accordion-a p{font-size:16px;line-height:24px;margin:0}
/* desktop: hover shows individual, mobile: click shows individual */
@media (min-width:1025px){ .accordion:hover .accordion-a{display:flex} }
@media (max-width:1024px){ .accordion:hover .accordion-a{display:none} }
.still{max-width:560px;margin:80px auto 0;text-align:center;display:flex;flex-direction:column;gap:24px;align-items:center}
.still h3{font-family:'Fraunces',serif;font-weight:600;font-size:36px;line-height:46.8px;margin:0}
.still p{font-family:'Cormorant Garamond', serif; font-style:italic; font-weight:500; font-size:21px;line-height:29px;margin:0}
/* Contact */
.contact{background:var(--peach);padding:80px 64px}
.contact-head{max-width:768px;display:flex;flex-direction:column;gap:16px}
.contact-head .tagline{font-size:16px;font-weight:600}
.contact-head h2{font-family:'Fraunces',serif;font-weight:600;font-size:52px;line-height:62.4px;margin:0}
.contact-head p{font-size:18px;line-height:27px;margin:0}
.contact-grid{display:grid;grid-template-columns:400px 1fr;gap:48px;margin-top:48px;align-items:start}
.contact-infos{display:flex;flex-direction:column;gap:40px}
.contact-item{display:flex;flex-direction:column;gap:16px}
.contact-item h3{font-family:'Fraunces',serif;font-weight:600;font-size:22px;line-height:30.8px;margin:0}
.contact-item p,.contact-item a{font-size:16px;line-height:24px;margin:0}
.contact-item a{text-decoration:underline}
.contact-img{height:516px;border-radius:32px;width:100%;object-fit:cover}
/* CTA */
.cta{background:var(--peach);padding:24px 64px 64px}
.cta-card{border-radius:32px;outline:1px solid #000;outline-offset:-1px;background:linear-gradient(0deg,rgba(0,0,0,.40),rgba(0,0,0,.40)),url('https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=1280&q=80') center/cover no-repeat;padding:48px;display:flex;flex-direction:column;gap:24px;align-items:flex-start}
.cta-card h2{font-family:'Fraunces',serif;font-weight:600;font-size:40px;line-height:48px;color:#fff;margin:0;max-width:700px}
.cta-card p{font-size:18px;line-height:27px;color:#fff;margin:0;max-width:600px}
.cta-actions{display:flex;gap:16px;flex-wrap:wrap}
/* Footer */
.footer{background:var(--ever);padding:72px 64px 48px;color:#fff}
.footer-top{display:grid;grid-template-columns:1.6fr 380px;gap:64px;align-items:start;justify-content:space-between}
.footer-links{display:grid;grid-template-columns:repeat(4, 1fr);gap:32px;width:100%}
.footer-col{flex:1;display:flex;flex-direction:column;gap:12px}
.footer-col h4{font-size:15px;font-weight:600;line-height:24px;margin:0 0 4px;letter-spacing:0.02em}
.footer-col a{font-size:14px;line-height:26px;opacity:.92;transition:opacity .15s}
.footer-col a:hover{opacity:1;text-decoration:underline}
.news h4{font-size:16px;font-weight:600;margin:0}
.news p{font-size:16px;line-height:24px;margin:0}
.news-form{display:flex;gap:16px;align-items:center;margin-top:16px}
.news-form .field{flex:1;border-bottom:2px solid #fff;padding:8px 0;display:flex;align-items:center}
.news-form .field input::placeholder{color:rgba(255,255,255,.8)}
.news-form .field input:focus{outline:none}
.news-form .field span{color:#fff;font-size:16px}
.footer-bottom{margin-top:80px;display:flex;flex-direction:column;gap:32px}
.divider{height:1px;background:#000;outline:1px solid #000}
.credits{display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap}
.credits a{text-decoration:underline;font-size:14px}
.social{display:flex;gap:12px}
.social a{width:24px;height:24px;display:flex}
/* responsive */
@media(max-width:1200px){
.hero h1{font-size:56px;line-height:67px}
.about-grid,.hero-grid,.contact-grid{grid-template-columns:1fr}
.about-img{height:500px}
.tab-pane{grid-template-columns:1fr}
.footer-top{grid-template-columns:1fr 1fr}
}
@media(max-width:1024px){
.banner,.navbar,.hero,.about,.menu-sec,.testi,.faq,.contact,.cta,.footer{padding-left:32px!important;padding-right:32px!important}
.hero{padding-top:60px;padding-bottom:60px;min-height:600px}
.about{padding-top:60px;padding-bottom:60px}
.menu-sec{padding-bottom:32px}
.testi,.faq,.contact{padding-top:48px;padding-bottom:48px}
.footer{padding:48px 32px 32px}
.footer-top{gap:40px}
.tab-pane img{height:420px}
.testi-grid{display:flex;flex-direction:column;gap:24px;max-height:680px;overflow-y:auto;scroll-snap-type:y mandatory;padding-right:8px;-webkit-overflow-scrolling:touch}
.testi-card{scroll-snap-align:start;flex-shrink:0}
.slider-arrow{display:none}
}
@media(max-width:768px){
.banner{padding-left:20px!important;padding-right:20px!important;padding-top:8px}
.banner-card{flex-direction:column;align-items:stretch}
.banner-form{width:100%}
.banner-form .field{flex:1}
.nav-inner{flex-wrap:wrap}
.nav-mid{order:3;width:100%;justify-content:flex-start}
.nav-right{gap:16px;flex-wrap:wrap}
.hero{padding:48px 20px;min-height:500px}
.hero h1{font-size:40px;line-height:48px}
.about h2{font-size:36px;line-height:43px}
.menu-card{padding:40px 0 0;gap:32px}
.menu-head h2{font-size:36px;line-height:43px}
.tab-btn{font-size:18px;padding:16px 12px}
.tab-pane{padding:24px;gap:24px}
.tab-pane h3{font-size:28px;line-height:33px}
.testi-head h2{font-size:36px;line-height:43px}
.testi-grid{display:flex;flex-direction:column;gap:24px}
.contact-grid{grid-template-columns:1fr}
.contact-head h2{font-size:36px;line-height:43px}
.cta{padding:24px 20px 60px}
.footer{padding:48px 20px}
.footer-top{grid-template-columns:1fr;gap:32px}
.footer-links{flex-wrap:wrap}
.credits{flex-direction:column;align-items:flex-start}
.hero-actions{flex-direction:row;align-items:center;flex-wrap:wrap;gap:12px}
.about-actions{flex-wrap:wrap}
}
@media(max-width:480px){
.banner,.navbar,.hero,.about,.menu-sec,.testi,.faq,.contact,.cta,.footer{padding-left:16px!important;padding-right:16px!important}
.hero h1{font-size:32px;line-height:38px}
.banner-card{border-radius:24px}
.hero{border-radius:0}
.about-img{height:360px}
.tab-pane img{height:320px}
.contact-img{height:360px}
}
</style>
