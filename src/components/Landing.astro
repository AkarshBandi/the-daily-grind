<script is:inline>
// CMS live preview patch: when opened as /?cms_preview_data={...} inside Sveltia iframe,
// patch the static HTML client-side so right pane shows exact frontend live per keystroke
(function(){
  try{
    const q = new URLSearchParams(location.search).get('cms_preview_data');
    if(!q) return;
    const d = JSON.parse(decodeURIComponent(q));
    const set = (sel, val)=>{ if(val==null) return; const el=document.querySelector(sel); if(el) el.textContent=val; };
    set('.hero h1', d.hero_heading);
    set('.hero .sub', d.hero_text);
    set('.about h2', (d.about&&d.about.heading)||d.about_heading);
    set('.about-grid > div > div > p:last-child', (d.about&&d.about.text)||d.about_text);
    set('.menu-head h2', d.menu&&d.menu.heading);
    set('.menu-head p', d.menu&&d.menu.text);
    set('.testi-head h2', d.testimonials&&d.testimonials.heading);
    set('.testi-head p', d.testimonials&&d.testimonials.text);
    set('.faq-head h2', d.faq&&d.faq.heading);
    set('.faq-head p', d.faq&&d.faq.text);
    set('.contact-head h2', d.contact&&d.contact.heading);
    set('.contact-head p', d.contact&&d.contact.text);
    set('.cta-card h2', d.cta&&d.cta.heading);
    set('.cta-card p', d.cta&&d.cta.text);
    // menu first tab live
    if(d.menu&&d.menu.tabs&&d.menu.tabs[0]){
      const t0=d.menu.tabs[0];
      set('#tab-'+(t0.id||'coffee')+' h3', t0.heading);
    }
  }catch(e){ console.log('preview patch skip', e); }
})();
document.addEventListener('DOMContentLoaded',()=>{
  const dd=document.getElementById('visit-dropdown');
  const trigger=dd?.querySelector('.nav-link');
  const menu=dd?.querySelector('.dropdown-menu');
  const isMobile=()=>window.innerWidth<=1024;
  const positionMenu=()=>{
    if(!dd||!menu) return;
    if(isMobile()){ menu.style.left=''; menu.style.right=''; menu.style.transform=''; return; }
    // desktop: center under trigger, flip if overflow
    menu.style.left='50%'; menu.style.right='auto'; menu.style.transform='translateX(-50%)';
    requestAnimationFrame(()=>{
      const r=menu.getBoundingClientRect();
      if(r.right > window.innerWidth - 16){ menu.style.left='auto'; menu.style.right='0'; menu.style.transform='none'; }
      else if(r.left < 16){ menu.style.left='0'; menu.style.right='auto'; menu.style.transform='none'; }
    });
  };
  if(dd && trigger && menu){
    trigger.addEventListener('click',(e)=>{
      if(!isMobile()) return;
      e.preventDefault();
      dd.classList.toggle('open');
      trigger.setAttribute('aria-expanded', dd.classList.contains('open')?'true':'false');
    });
    trigger.addEventListener('mouseenter',()=>{ if(!isMobile()) positionMenu(); });
    dd.addEventListener('mouseenter',()=>{ if(!isMobile()) positionMenu(); });
    window.addEventListener('resize',()=>{ dd.classList.remove('open'); positionMenu(); });
    window.addEventListener('scroll',()=>{ if(!isMobile() && dd.matches(':hover')) positionMenu(); },{passive:true});
    document.addEventListener('click',(e)=>{
      if(!dd.contains(e.target)) {dd.classList.remove('open'); trigger.setAttribute('aria-expanded','false')}
    });
    positionMenu();
  }
  // tabs
  document.querySelectorAll('.tab-btn').forEach(btn=>{
    btn.addEventListener('click',()=>{
      document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));
      btn.classList.add('active');
      const t=btn.dataset.tab;
      document.querySelectorAll('.tab-pane').forEach(p=>p.style.display='none');
      const show=document.getElementById('tab-'+t);
      if(show) show.style.display='grid';
    })
  });
  // accordions: desktop hover (CSS), mobile/tab click individual
  document.querySelectorAll('.accordion').forEach(acc=>{
    acc.addEventListener('click',()=>{
      if (window.innerWidth > 1024) return;
      const was=acc.classList.contains('open');
      document.querySelectorAll('.accordion').forEach(a=>a.classList.remove('open'));
      if(!was) acc.classList.add('open');
    })
  });
  // banner close
  const bx=document.querySelector('.banner-x');
  const banner=document.querySelector('.banner');
  if(bx && banner) bx.addEventListener('click',()=>banner.style.display='none');
});
</script>

<script>
  // Skip GSAP in CMS preview edit mode (faster load, reveals already forced visible)
  if (!new URLSearchParams(location.search).get('edit')) {
    import('gsap').then(function(mod) {
      var gsap = mod.default;
      import('gsap/ScrollTrigger').then(function(smod) {
        var ScrollTrigger = smod.default;
        gsap.registerPlugin(ScrollTrigger);
        var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!prefersReduced) {
          gsap.utils.toArray('.reveal').forEach(function(el) {
            gsap.from(el, {
              y: 28,
              opacity: 0,
              duration: 0.7,
              ease: 'power2.out',
              scrollTrigger: {
                trigger: el,
                start: 'top 88%',
                toggleActions: 'play none none reverse'
              }
            });
          });
          var hero = document.querySelector('.hero');
          if (hero) {
            gsap.to(hero, {
              backgroundPosition: '50% 30%',
              ease: 'none',
              scrollTrigger: {
                trigger: hero,
                start: 'top top',
                end: 'bottom top',
                scrub: true
              }
            });
          }
        }
      });
    });
  }
</script>
