  <!-- FAQ -->
  <section class="faq reveal" id="faq" data-tina-field={tinaField(d, 'faq')}>
    <div class="inner">
      <div class="faq-head">
        <h2 class="reveal" data-cms="faq.heading">{faqHeading}</h2>
        <p data-cms="faq.text">{faqText}</p>
      </div>
