---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import * as yaml from 'js-yaml';
import designRaw from '../content/site/design.yaml?raw';
const { title = 'Fast static websites that bring customers. A Studio', current = '' } = Astro.props;
let design: Record<string,string> = {};
try { design = yaml.load(designRaw) as any; } catch {}
const paper = design.paper || '#FFFFFF';
const cream = design.cream || '#F5F1EA';
const ink = design.ink || '#0A0A0A';
const muted = design.muted || '#555555';
const accent = design.accent || '#0A0A0A';
const maxW = design.max_width || '1200px';
const pad = design.pad || 'clamp(4rem, 2.18rem + 8.1vw, 8.25rem)';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content="Fast static websites for business owners. No builders, no bloat. Pages that load instantly and bring customers." />
<ClientRouter fallback="animate" />
<Fragment set:html={`<style>:root{--paper:${paper};--cream:${cream};--ink:${ink};--muted:${muted};--accent:${accent};--max:${maxW};--pad:${pad}}</style>`} />
</head>
<body>
<header class="site-head" transition:persist>
  <div id="progress" aria-hidden="true"></div>
  <div id="page-fader" aria-hidden="true"></div>
  <div class="wrap">
    <a class="logo" href="/" data-link>A&thinsp;·&thinsp;Studio</a>
    <nav class="primary" aria-label="Primary">
      <a href="/" data-link aria-current={current === 'home' ? 'page' : undefined}>Home</a>
      <a href="/work" data-link aria-current={current === 'work' ? 'page' : undefined}>Work</a>
      <a href="/approach" data-link aria-current={current === 'approach' ? 'page' : undefined}>Approach</a>
      <a href="/contact" data-link aria-current={current === 'contact' ? 'page' : undefined}>Contact</a>
    </nav>
    <button id="menuBtn" type="button" aria-expanded="false" aria-controls="mnav" aria-label="Open menu">
      <span></span><span></span>
    </button>
  </div>
  <div id="mnav" aria-hidden="true">
    <nav aria-label="Mobile">
      <a href="/" data-link>Home</a>
      <a href="/work" data-link>Work</a>
      <a href="/approach" data-link>Approach</a>
      <a href="/contact" data-link>Contact</a>
    </nav>
    <p class="mnav-foot"><strong>A · Studio</strong>. Static sites. Cloudflare hosting.</p>
  </div>
</header>

<main id="main" transition:animate="none">
  <slot />
</main>

<footer transition:persist>
  <div class="wrap">
    <span><strong>A · Studio</strong>. Static sites. Cloudflare hosting.</span>
    <span><a href="/contact" data-link>Contact <span class="arr" aria-hidden="true">→</span></a></span>
  </div>
</footer>

<script>
import Lenis from 'lenis';
import gsap from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
import { navigate } from 'astro:transitions/client';

gsap.registerPlugin(ScrollTrigger);
const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

let lenis = (window as any).__lenis;
if (!lenis && !reduce) {
  lenis = new Lenis({ duration: 1.2, smoothWheel: true });
  (window as any).__lenis = lenis;
  lenis.on('scroll', ScrollTrigger.update);
  gsap.ticker.add((t: number) => lenis.raf(t * 1000));
  gsap.ticker.lagSmoothing(0);
}

const fader = document.getElementById('page-fader');
let busy = false;
let pageMMs: any[] = [];
function killTriggers() {
  ScrollTrigger.getAll().forEach(s => s.kill());
  pageMMs.forEach(m => m.revert());
  pageMMs = [];
  document.querySelectorAll('.side-track.is-sideways').forEach(t => t.classList.remove('is-sideways'));
}

// single fade: 200ms out, 250ms in - no stagger, no double
async function fadeOut() {
  if (reduce) return;
  await gsap.to('#main', { opacity: 0, y: -6, duration: 0.2, ease: 'power2.in' }).then();
}
async function fadeIn() {
  if (reduce) {
    gsap.set('#main', { clearProps: 'all' });
    return;
  }
  gsap.set('#main', { opacity: 0, y: 6 });
  await gsap.to('#main', { opacity: 1, y: 0, duration: 0.25, ease: 'power2.out', clearProps: 'all' }).then();
}
function heroIn() {
  if (reduce) return;
  const targets = document.querySelectorAll('.mask > span:not(.no-gsap)');
  if (targets.length) gsap.fromTo(targets,
    { yPercent: 110 }, { yPercent: 0, duration: 0.9, ease: 'power4.out', stagger: 0.08 });
}
function genericReveals() {
  if (reduce) { gsap.set('[data-reveal]', { clearProps: 'all' }); return; }
  const isHome = location.pathname === '/' || location.pathname === '';
  const start = isHome ? 'top 90%' : 'top 82%';
  const duration = isHome ? 0.55 : 0.7;
  gsap.utils.toArray('[data-reveal]').forEach((el: any) => {
    gsap.fromTo(el, { y: 28, opacity: 0 },
      { y: 0, opacity: 1, duration, ease: 'power2.out',
        scrollTrigger: { trigger: el, start, once: true } });
  });
}
function progressBar() {
  const bar = document.getElementById('progress');
  if (!bar || reduce) { if (bar) bar.style.display = 'none'; return; }
  bar.style.display = '';
  gsap.fromTo(bar, { scaleX: 0 }, { scaleX: 1, ease: 'none',
    scrollTrigger: { start: 0, end: 'max', scrub: 0.3 } });
}
function heroOut() {
  const inner = document.querySelector('.stage-inner');
  if (!inner || reduce) return;
  gsap.to(inner, { y: -80, opacity: 0, ease: 'none',
    scrollTrigger: { trigger: '.stage', start: 'top top', end: 'bottom 35%', scrub: true } });
}
function peel() {
  const top = document.querySelector('.peel-top');
  const stage = document.querySelector('.peel-stage');
  if (!top || !stage || reduce) return;
  gsap.set(top, { clipPath: 'polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)' });
  const mm = gsap.matchMedia();
  pageMMs.push(mm);
  mm.add('(min-width: 1025px)', () => {
    const tl = gsap.timeline({
      scrollTrigger: { trigger: stage, start: 'top top', end: '+=220%', pin: true, scrub: 1 } });
    tl.to('.peel-top .bloat', { y: -70, opacity: 0, rotation: () => gsap.utils.random(-7, 7),
        stagger: 0.12, ease: 'none' }, 0)
      .to(top, { clipPath: 'polygon(100% 0%, 100% 0%, 100% 100%, 100% 100%)', ease: 'none' }, 0.5);
  });
  mm.add('(max-width: 1024px)', () => {
    const tl = gsap.timeline({
      scrollTrigger: { trigger: stage, start: 'top bottom', end: 'bottom 35%', scrub: 1 } });
    tl.to('.peel-top .bloat', { y: -40, opacity: 0, stagger: 0.1, ease: 'none' }, 0)
      .to(top, { clipPath: 'polygon(100% 0%, 100% 0%, 100% 100%, 100% 100%)', ease: 'none' }, 0.4);
  });
}
function sideways() {
  const track = document.querySelector('.side-track');
  if (!track || reduce) return;
  const mm = gsap.matchMedia();
  pageMMs.push(mm);
  mm.add('(min-width: 1025px)', () => {
    track.classList.add('is-sideways');
    const getX = () => -((track as HTMLElement).scrollWidth - window.innerWidth);
    gsap.to(track, { x: getX, ease: 'none',
      scrollTrigger: { trigger: '.side-pin', start: 'top top',
        end: () => '+=' + ((track as HTMLElement).scrollWidth - window.innerWidth),
        pin: true, scrub: 1, invalidateOnRefresh: true } });
  });
}
function wordScrub() {
  if (reduce) return;
  document.querySelectorAll('[data-words]').forEach((el) => {
    const words = (el.textContent || '').trim().split(/\s+/);
    el.innerHTML = words.map(w => '<span class="w">' + w + '</span>').join(' ');
    gsap.to(el.querySelectorAll('.w'), { opacity: 1, ease: 'none', stagger: 0.06,
      scrollTrigger: { trigger: el, start: 'top 78%', end: 'bottom 45%', scrub: true } });
  });
}
function syncNav() {
  const path = location.pathname.replace(/\/+$/, '') || '/';
  document.querySelectorAll('header nav.primary a, #mnav nav a').forEach((a) => {
    const href = a.getAttribute('href');
    const on = href === '/' ? path === '/' : path === href;
    if (on) a.setAttribute('aria-current', 'page');
    else a.removeAttribute('aria-current');
  });
}
let menuOpen = false;
let lastFocus: any = null;
function setMenu(open: boolean) {
  const btn = document.getElementById('menuBtn');
  const panel = document.getElementById('mnav');
  if (!btn || !panel) return;
  menuOpen = open;
  btn.classList.toggle('open', open);
  btn.setAttribute('aria-expanded', String(open));
  btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  panel.setAttribute('aria-hidden', String(!open));
  if (open) {
    lastFocus = document.activeElement;
    if ((window as any).__lenis) (window as any).__lenis.stop();
    if (reduce) {
      gsap.set(panel, { visibility: 'visible', opacity: 1 });
    } else {
      gsap.timeline()
        .set(panel, { visibility: 'visible' })
        .fromTo(panel, { opacity: 0 }, { opacity: 1, duration: 0.3, ease: 'power2.out' }, 0)
        .fromTo('#mnav nav a', { y: 44, opacity: 0 },
          { y: 0, opacity: 1, duration: 0.6, ease: 'expo.out', stagger: 0.06 }, 0.05);
    }
    const first = panel.querySelector('nav a');
    if (first) (first as HTMLElement).focus({ preventScroll: true });
  } else {
    if (reduce) gsap.set(panel, { visibility: 'hidden', opacity: 0 });
    else gsap.to(panel, { opacity: 0, duration: 0.2, ease: 'power2.in',
      onComplete: () => gsap.set(panel, { visibility: 'hidden' }) });
    if (!busy && (window as any).__lenis) (window as any).__lenis.start();
    if (lastFocus && lastFocus.focus) lastFocus.focus({ preventScroll: true });
  }
}
function proofChapters() {
  const stages = gsap.utils.toArray('.proof-stage');
  if (!stages.length || reduce) return;
  const mm = gsap.matchMedia();
  pageMMs.push(mm);
  mm.add('(min-width: 1025px)', () => {
    stages.forEach((stage: any) => {
      const head = stage.querySelector('.proof-head');
      const before = stage.querySelector('.pcard.before');
      const after = stage.querySelector('.pcard.after');
      const tl = gsap.timeline({
        scrollTrigger: { trigger: stage, start: 'top top', end: '+=160%', pin: true, scrub: 1 } });
      if (head) tl.fromTo(head, { y: 50 }, { y: -30, ease: 'none' }, 0);
      if (before) tl.fromTo(before, { y: 150, opacity: 0 }, { y: 0, opacity: 1, ease: 'none' }, 0.1);
      if (after) tl.fromTo(after, { y: 220, opacity: 0 }, { y: 0, opacity: 1, ease: 'none' }, 0.28);
    });
  });
  mm.add('(max-width: 1024px)', () => {
    gsap.utils.toArray('.proof-head, .pcard').forEach((el: any) => {
      gsap.fromTo(el, { y: 48, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.8, ease: 'power3.out',
          scrollTrigger: { trigger: el, start: 'top 88%', once: true } });
    });
  });
}
function buttons() {
  if (reduce) return;
  const fine = window.matchMedia('(pointer: fine)').matches;
  document.querySelectorAll('.btn').forEach((btn: any) => {
    if (btn.classList.contains('js-fill')) return;
    btn.classList.add('js-fill');
    const dark = !!btn.closest('.band-dark, .contact-block');
    const fill = dark ? '#FFFFFF' : '#0A0A0A';
    const ink = dark ? '#0A0A0A' : '#FFFFFF';
    btn.style.backgroundImage = 'linear-gradient(' + fill + ',' + fill + ')';
    const arr = btn.querySelector('.arr');
    const baseColor = getComputedStyle(btn).color;
    btn.addEventListener('mouseenter', () => {
      gsap.set(btn, { backgroundPosition: '0% 0%' });
      gsap.to(btn, { backgroundSize: '100% 100%', duration: 0.45, ease: 'expo.out', overwrite: 'auto' });
      gsap.to(btn, { color: ink, duration: 0.2, delay: 0.08, overwrite: 'auto' });
      if (arr) gsap.to(arr, { x: 6, duration: 0.35, ease: 'power3.out', overwrite: 'auto' });
    });
    btn.addEventListener('mouseleave', () => {
      gsap.set(btn, { backgroundPosition: '100% 0%' });
      gsap.to(btn, { backgroundSize: '0% 100%', duration: 0.4, ease: 'expo.in', overwrite: 'auto' });
      gsap.to(btn, { color: baseColor, duration: 0.25, overwrite: 'auto' });
      if (arr) gsap.to(arr, { x: 0, duration: 0.3, ease: 'power3.out', overwrite: 'auto' });
      if (fine) { gsap.to(btn, { x: 0, y: 0, duration: 0.6, ease: 'expo.out' }); }
    });
    if (fine) {
      const xTo = gsap.quickTo(btn, 'x', { duration: 0.4, ease: 'power3.out' });
      const yTo = gsap.quickTo(btn, 'y', { duration: 0.4, ease: 'power3.out' });
      btn.addEventListener('mousemove', (e: any) => {
        const r = btn.getBoundingClientRect();
        xTo(gsap.utils.clamp(-6, 6, (e.clientX - (r.left + r.width / 2)) / 6));
        yTo(gsap.utils.clamp(-6, 6, (e.clientY - (r.top + r.height / 2)) / 6));
      });
    }
  });
  document.querySelectorAll('.cta-giant .arr').forEach((arr) => {
    const link = arr.closest('a');
    link?.addEventListener('mouseenter', () => gsap.to(arr, { x: 12, duration: 0.4, ease: 'expo.out', overwrite: 'auto' }));
    link?.addEventListener('mouseleave', () => gsap.to(arr, { x: 0, duration: 0.35, ease: 'power3.out', overwrite: 'auto' }));
  });
}

function initPage() {
  killTriggers();
  setMenu(false);
  syncNav();
  window.scrollTo(0, 0);
  if ((window as any).__lenis) (window as any).__lenis.scrollTo(0, { immediate: true });
  heroIn(); genericReveals(); peel(); sideways(); wordScrub(); proofChapters(); buttons();
  progressBar(); heroOut();
  settleRefresh();
  ScrollTrigger.refresh();
}

let settleQueued = false;
function settleRefresh() {
  if (settleQueued) return;
  settleQueued = true;
  const done = () => { settleQueued = false; ScrollTrigger.refresh(); };
  if (document.readyState === 'complete') { done(); return; }
  window.addEventListener('load', done, { once: true });
  setTimeout(done, 2500);
}
if (document.fonts && (document.fonts as any).ready) {
  (document.fonts as any).ready.then(() => ScrollTrigger.refresh()).catch(() => {});
}
document.addEventListener('load', (e) => {
  const t = e.target as HTMLElement;
  if (t && (t.tagName === 'IMG' || t.tagName === 'VIDEO')) ScrollTrigger.refresh();
}, true);
document.addEventListener('error', (e) => {
  const t = e.target as HTMLElement;
  if (t && (t.tagName === 'IMG' || t.tagName === 'VIDEO')) ScrollTrigger.refresh();
}, true);
ScrollTrigger.config({ ignoreMobileResize: true });

document.getElementById('menuBtn')?.addEventListener('click', () => setMenu(!menuOpen));
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape' && menuOpen) setMenu(false);
});
window.addEventListener('resize', () => {
  if (menuOpen && window.innerWidth > 860) setMenu(false);
});
document.addEventListener('click', (e) => {
  if (menuOpen && (e.target as HTMLElement).closest('#mnav a[data-link]')) setMenu(false);
}, true);

// View-Transition-driven nav: GSAP fade out -> navigate -> Astro fades in
document.addEventListener('click', async (e) => {
  const a = (e.target as HTMLElement).closest('a[data-link]') as HTMLAnchorElement | null;
  if (!a) return;
  const href = a.getAttribute('href');
  if (!href || !href.startsWith('/') || (e as MouseEvent).metaKey || (e as MouseEvent).ctrlKey || (e as MouseEvent).shiftKey || (e as MouseEvent).altKey) return;
  if (new URL(href, location.origin).pathname === location.pathname || busy) return;
  e.preventDefault();
  e.stopPropagation();
  busy = true;
  if ((window as any).__lenis) (window as any).__lenis.stop();
  await fadeOut();
  try { await navigate(href); } catch { location.href = href; return; }
}, true);

document.addEventListener('astro:after-swap', async () => {
  await fadeIn();
  if ((window as any).__lenis) (window as any).__lenis.start();
  initPage();
  const h1 = document.querySelector('main h1') as HTMLElement | null;
  if (h1) {
    h1.setAttribute('tabindex', '-1');
    h1.focus({ preventScroll: true });
  }
  busy = false;
});
initPage();
</script>
</body>
</html>
