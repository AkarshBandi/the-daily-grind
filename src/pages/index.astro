---
// Prerendered so visitors are served from the ASSETS binding and never invoke
// the Worker. Only routes that opt out (the island, /api/contact) run on it.
export const prerender = true;

import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import Landing from '../components/Landing.astro';
import { getHome } from '../lib/tina/data';
import { islands } from '../lib/tina/islands';

const homeResult = await getHome();
const home = homeResult.data?.home as any;
const seoTitle = home?.seo_title ?? 'Hearth & Honey — Your neighborhood spot for coffee and good company';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{seoTitle}</title>
  <meta name="description" content={home?.hero_text ?? ''} />
  <!-- Self-hosted instead of four Google Fonts families. The stylesheet was a
       third-party round trip before first paint and it requested 57 @font-face
       rules across six subsets; this site is English, so 8 latin files cover
       it. -->
  <link rel="preload" as="font" type="font/woff2" href="/fonts/fraunces-600-n-latin.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/fonts/dm-sans-400-n-latin.woff2" crossorigin />
  <link rel="stylesheet" href="/fonts/fonts.css" />
  <!-- global.css is bundled by Astro into /_astro/*.css; the old /styles/global.css
       link 404d and logged a console error. -->
</head>
<body>
  <TinaIsland name="home" wrapper={islands.home.wrapper} params={{}} primary>
    <Landing d={home} />
  </TinaIsland>
  <script src="/js/tina-guard.js" is:inline></script>
</body>
</html>
