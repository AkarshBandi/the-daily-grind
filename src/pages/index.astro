---
import homeRaw from '../content/pages/home.yaml?raw';
import * as yaml from 'js-yaml';
let f:any={};
try{ f = yaml.load(homeRaw) as any; }catch{}
// Live CMS preview override: when /?cms_preview_data={...} is present (from Sveltia iframe preview),
// use that data instead of the file so right pane shows exact frontend live per keystroke
try{
  const previewParam = Astro.url.searchParams.get('cms_preview_data');
  if(previewParam){
    const previewData = JSON.parse(decodeURIComponent(previewParam));
    if(previewData && typeof previewData === 'object'){ f = { ...f, ...previewData }; }
  }
}catch{}
const t = (k:string, fallback:string)=> (f && f[k] != null && f[k] !== '') ? f[k] : fallback;
const pick = (obj:any, key:string, fallback:string)=> (obj && obj[key] != null && obj[key] !== '') ? obj[key] : fallback;
// preserve figma exact strings
const seoTitle = t('seo_title','Hearth & Honey — Your neighborhood spot for coffee and good company');
const heroHeading = t('hero_heading','Your neighborhood spot for coffee and good company');
const heroText = t('hero_text','We serve specialty coffee, fresh pastries, and all-day breakfast in a warm, modern space. Come in, sit down, and stay awhile.');
const heroBtns = f?.hero_buttons || [{label:'Explore Menu',href:'#menu'},{label:'Book a Table',href:'#book'}];
const navLinks = f?.navbar_links || [{label:'Our story',href:'#story'},{label:'Menu',href:'#menu'},{label:'Visit',href:'#visit',dropdown:['Hours','Location','Contact']}];
// Banner (full content left)
const banner = f?.banner || {};
const bannerEnabled = banner.enabled !== false;
const bannerHeading = pick(banner,'heading','Fresh pastries are half off after 3 pm');
const bannerText = pick(banner,'text','Join the list for the daily special');
const bannerPlaceholder = pick(banner,'placeholder','Enter your email');
const bannerButton = pick(banner,'button','Sign up');
// Navbar
const navbarObj = f?.navbar || {};
const navLogo = pick(navbarObj,'logo','Hearth & Honey');
const navCtaLabel = pick(navbarObj,'cta_label','Book a Table');
const navCtaHref = pick(navbarObj,'cta_href','#book');
// About (supports both flat about_heading/about_text and nested about object for full left)
const aboutObj = f?.about || {};
const aboutTagline = pick(aboutObj,'tagline','About');
const aboutHeading = pick(aboutObj,'heading', t('about_heading','A good café is a clean, well-lighted place'));
const aboutText = pick(aboutObj,'text', t('about_text','We built Hearth & Honey to be simple and true. Good coffee, honest food, and a room that feels right.'));
const aboutImage = pick(aboutObj,'image','/shots/figma-1.png');
// Menu
const menuObj = f?.menu || {};
const menuTag = pick(menuObj,'tag','Menu');
const menuHeading = pick(menuObj,'heading','What we do well');
const menuText = pick(menuObj,'text','A few things we make every day. They are simple and they are good.');
const menuTabs = (menuObj?.tabs && menuObj.tabs.length ? menuObj.tabs : [
  {id:'coffee',label:'Coffee',tag:'Coffee',heading:'The flat white is true and strong',text:'We pull shots from beans roasted two miles away. The milk is steamed clean, no tricks.',image:'/shots/figma-2.png'},
  {id:'breakfast',label:'Breakfast',tag:'Breakfast',heading:'Morning plates done right',text:'Eggs, sourdough, and seasonal sides — simple and satisfying.',image:'https://images.unsplash.com/photo-1490818387583-1baba5e638af?auto=format&fit=crop&w=800&q=80'},
  {id:'brunch',label:'Brunch',tag:'Brunch',heading:'Long table, good coffee',text:'Bring friends. We keep the kitchen open till three.',image:'https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&w=800&q=80'},
  {id:'pastries',label:'Pastries',tag:'Pastries',heading:'Baked every morning',text:'Croissants, buns, and half-price after 3 pm.',image:'https://images.unsplash.com/photo-1555507036-ab1f4038808a?auto=format&fit=crop&w=800&q=80'},
  {id:'light',label:'Light meals',tag:'Light meals',heading:'Soups and salads',text:'Fresh, honest, and quick.',image:'https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=800&q=80'},
  {id:'drinks',label:'Drinks',tag:'Drinks',heading:'More than coffee',text:'Tea, juice, and cold brew on tap.',image:'https://images.unsplash.com/photo-1551024506-0bccd828d307?auto=format&fit=crop&w=800&q=80'},
]);
// Testimonials
const testiObj = f?.testimonials || {};
const testiHeading = pick(testiObj,'heading','Customer testimonials');
const testiText = pick(testiObj,'text','Come for the coffee. Stay for the moment.');
const testiItems = (testiObj?.items && testiObj.items.length ? testiObj.items : [
  {quote:'The espresso is the best in the neighborhood. No argument.',stars:5,avatar:'/shots/avatar-0.jpg',name:'Maya Chen',role:'Regular'},
  {quote:'A clean, bright room where a man can sit alone with a paper and not be bothered.',stars:5,avatar:'/shots/avatar-1.jpg',name:'Daniel Brooks',role:'Local writer'},
  {quote:'The sourdough toast with eggs is honest food. It does not pretend.',stars:5,avatar:'/shots/avatar-2.jpg',name:'Sarah Kim',role:'Brunch regular'},
]);
// FAQ
const faqObj = f?.faq || {};
const faqHeading = pick(faqObj,'heading','FAQs');
const faqText = pick(faqObj,'text','Find quick answers about your visit to Hearth & Honey');
const faqItems = (faqObj?.items && faqObj.items.length ? faqObj.items : [
  {q:'What are your hours?',a:'We are open Monday through Friday from 7 am to 4 pm. Weekends we open at 8 am and close at 3 pm.'},
  {q:'Do you have Wi-Fi?',a:'Yes, the Wi-Fi is free and fast. Bring your laptop and settle in.'},
  {q:'Do you offer vegan options?',a:'We always have oat and almond milk for coffee. The kitchen keeps a few vegan dishes on the menu each day.'},
  {q:'Do I need a reservation?',a:'Walk-ins are always welcome. For groups of six or more, a quick call ahead helps us save you a table.'},
  {q:'Is there gluten-free food?',a:'We bake a gluten-free banana bread most mornings. Ask at the counter for what is available that day.'},
]);
const faqStillHeading = pick(faqObj,'still_heading','Still have questions?');
const faqStillText = pick(faqObj,'still_text',"Haven't found what you're looking for? Our team is happy to help — ask us anything.");
const faqStillButton = pick(faqObj,'still_button','Get in Touch');
// Contact
const contactObj = f?.contact || {};
const contactTagline = pick(contactObj,'tagline','Visit Us');
const contactHeading = pick(contactObj,'heading','Contact us');
const contactText = pick(contactObj,'text','Find us on Hearth Lane — open daily from 7am. Drop in, call ahead, or send a note.');
const contactItems = (contactObj?.items && contactObj.items.length ? contactObj.items : [
  {heading:'Email',text:'For general enquiries and catering',link:'hello@hearthandhoney.example',link_text:'hello@hearthandhoney.example'},
  {heading:'Phone',text:'For reservations and takeaway orders',link:'tel:+61290001234',link_text:'+61 2 9000 1234'},
  {heading:'Visit',text:'12 Hearth Lane, Surry Hills NSW 2010 AU',link:'#',link_text:'Get Directions'},
]);
const contactImage = pick(contactObj,'image','/shots/figma-3.png');
// CTA
const ctaObj = f?.cta || {};
const ctaHeading = pick(ctaObj,'heading','See you at the counter');
const ctaText = pick(ctaObj,'text','Stop by for a coffee or stay for brunch. The kettle is on and the door is open.');
// Footer
const footerObj = f?.footer || {};
const footerNewsletterHeading = pick(footerObj,'newsletter_heading','Get in touch');
const footerNewsletterText = pick(footerObj,'newsletter_text','Get the word on new roasts and weekend specials. No noise, just news.');
const footerPlaceholder = pick(footerObj,'placeholder','Enter your email');
const footerButton = pick(footerObj,'button','Subscribe');
const footerFineprint = pick(footerObj,'fineprint','By subscribing you agree to our Privacy Policy');
import Landing from "../components/Landing.astro";
---
<Landing d={f} />
