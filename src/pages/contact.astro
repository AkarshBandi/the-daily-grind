---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact: email me directly" current="contact">
<section>
  <div class="wrap">
    <p class="kicker" data-exit>Contact</p>
    <h1 class="hero-title" data-exit>
      <span class="mask"><span>No form.</span></span>
      <span class="mask"><span>No maze.</span></span>
    </h1>
    <p class="lede" data-reveal style="margin-top:24px">One click opens your email app. Tell me what you sell and what page you need.</p>
  </div>
</section>
<div class="contact-block">
  <div class="wrap" data-reveal>
    <p class="kicker" style="color:#FAF9F6">Direct email. Nothing else to click</p>
    <a class="mailto-big" href="mailto:akarshbandi82@gmail.com?subject=Fast%20static%20site%20enquiry">akarshbandi82@gmail.com</a>
    <p style="margin-top:28px;opacity:.75">Replies within two working days.</p>
  </div>
</div>
</Layout>
